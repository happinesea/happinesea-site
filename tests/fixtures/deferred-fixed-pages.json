    "content_html": "\n<figure class=\"wp-block-image size-large\"><img decoding=\"async\" loading=\"lazy\" width=\"776\" height=\"653\" src=\"https://happinesea.com/wp-content/uploads/2021/01/pixhawk-1.png\" alt=\"\" class=\"wp-image-1407\" srcset=\"https://happinesea.com/wp-content/uploads/2021/01/pixhawk-1.png 776w, https://happinesea.com/wp-content/uploads/2021/01/pixhawk-1-300x252.png 300w, https://happinesea.com/wp-content/uploads/2021/01/pixhawk-1-768x646.png 768w\" sizes=\"(max-width: 776px) 100vw, 776px\" /></figure>\n\n\n\n<h2 class=\"has-text-align-center wp-block-heading\">ユーザマニュアル</h2>\n\n\n\n<p>対応モデル：固定翼飛行機/グライダー/マルチコプター/ヘリコプター/カー/ボート/ロボット</p>\n\n\n\n<p>日本語版(準備中)</p>\n\n\n\n<p><a href=\"https://radiolink.com/pixhawk_manual\" target=\"_blank\" rel=\"noreferrer noopener\">英語版</a></p>\n",
