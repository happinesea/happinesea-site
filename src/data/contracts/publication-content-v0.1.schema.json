{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:happinesea:wordpress-publication-contract:v0.1:publication-content",
  "title": "happinesea WordPress Publication Content v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "id",
    "slug",
    "title",
    "excerpt",
    "content",
    "published_at",
    "modified_at",
    "category",
    "tags",
    "featured_image",
    "featured_image_alt",
    "canonical",
    "content_type",
    "status"
  ],
  "properties": {
    "contract_version": { "const": "0.1" },
    "id": { "type": "integer", "minimum": 1 },
    "slug": {
      "type": "string",
      "pattern": "^(?:[a-z0-9]|%[0-9a-f]{2})+(?:-(?:[a-z0-9]|%[0-9a-f]{2})+)*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "excerpt": { "type": "string", "minLength": 1 },
    "content": { "type": "string", "minLength": 1 },
    "published_at": { "type": "string", "format": "date-time" },
    "modified_at": { "type": "string", "format": "date-time" },
    "category": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9]|%[0-9a-f]{2})+(?:-(?:[a-z0-9]|%[0-9a-f]{2})+)*$"
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:[a-z0-9]|%[0-9a-f]{2})+(?:-(?:[a-z0-9]|%[0-9a-f]{2})+)*$"
      }
    },
    "featured_image": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "width", "height"],
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "source_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "attribution": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "featured_image_alt": { "type": "string" },
    "canonical": { "type": "string", "format": "uri", "pattern": "^https://" },
    "content_type": { "type": "string", "enum": ["insight", "product_update"] },
    "status": { "const": "publish" },
    "source_url": { "type": "string", "format": "uri", "pattern": "^https://" },
    "author": { "type": "string", "minLength": 1 },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "seo_title": { "type": "string", "minLength": 1 },
    "meta_description": { "type": "string", "minLength": 1 },
    "noindex": { "type": "boolean", "default": false },
    "related_product_slugs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "update_type": {
      "type": "string",
      "enum": [
        "new_product",
        "firmware",
        "manual_update",
        "manufacturer_notice"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "featured_image": { "type": "null" } },
        "required": ["featured_image"]
      },
      "then": {
        "properties": { "featured_image_alt": { "maxLength": 0 } }
      }
    },
    {
      "if": {
        "properties": { "content_type": { "const": "product_update" } },
        "required": ["content_type"]
      },
      "then": {
        "required": ["source_url", "related_product_slugs", "update_type"]
      }
    },
    {
      "if": {
        "properties": {
          "update_type": {
            "enum": ["new_product", "firmware", "manual_update"]
          }
        },
        "required": ["update_type"]
      },
      "then": { "properties": { "related_product_slugs": { "minItems": 1 } } }
    },
    {
      "if": {
        "properties": { "content_type": { "const": "insight" } },
        "required": ["content_type"]
      },
      "then": { "not": { "required": ["update_type"] } }
    }
  ]
}
