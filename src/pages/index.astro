---
import { getCollection } from 'astro:content';
import Hero from '../components/Hero.astro';
import InsightCard from '../components/InsightCard.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';

const products = await getCollection('products');
const updates = await getCollection('productUpdates');
const insights = (await getCollection('insights')).filter(
  ({ data }) => data.content_status === 'published',
);
const featuredSlugs = ['rc8x', 'rc8p', 't12d', 'r8fg'];
const featuredProducts = products
  .filter(({ data }) => featuredSlugs.includes(data.slug))
  .sort(
    (left, right) =>
      featuredSlugs.indexOf(left.data.slug) -
      featuredSlugs.indexOf(right.data.slug),
  );
const insightTopics = [
  '航空・ドローン',
  'RC技術',
  '法規・制度',
  '業界動向',
  '技術解説',
  '導入事例',
];
---

<BaseLayout>
  <Hero
    eyebrow="製品・サポート / 業界・技術"
    title="使うための情報と、理解するための知識を。"
    description="happineseaは、製品を選び使い続けるための情報と、航空・RC・ドローン分野を読み解くための記事を届ける日本語技術・サポートサイトです。"
    actions={[
      { label: '製品を見る', href: withBase('/radiolink/') },
      {
        label: '業界・技術を読む',
        href: withBase('/insights/'),
        secondary: true,
      },
    ]}
    visuals={[
      {
        src: '/assets/radiolink/catalogue/rc8x.webp',
        alt: 'Radiolink RC8X送信機',
        label: '送信機',
      },
      {
        src: '/assets/radiolink/catalogue/r16f.webp',
        alt: 'Radiolink R16F受信機',
        label: '受信機',
      },
      {
        src: '/assets/radiolink/catalogue/pix6.webp',
        alt: 'Radiolink PIX6フライトコントローラー',
        label: 'フライトコントローラー',
      },
    ]}
  />

  <section class="bg-slate-50">
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-16 lg:px-8 lg:py-24">
      <SectionHeading
        eyebrow="Two Pillars"
        title="happineseaの2つの入口"
        description="製品を探すときも、技術の背景を知りたいときも、ここから目的の情報へ進めます。"
      />
      <div class="mt-10 grid gap-6 lg:grid-cols-2">
        <article
          id="products-support"
          class="flex h-full flex-col rounded-3xl border border-slate-200 border-t-4 border-t-teal-600 bg-white p-7 shadow-sm sm:p-9"
          data-home-pillar="products-support"
        >
          <p class="m-0 text-sm font-bold tracking-[0.16em] text-teal-700 uppercase">
            Products & Support
          </p>
          <h2 class="mt-3 mb-0 text-3xl font-bold text-slate-950 sm:text-4xl">
            製品・サポート
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            83製品の一覧、公開中の商品情報、マニュアル、FAQ、更新情報をひとつの流れで確認できます。
          </p>
          <a
            class="mt-3 inline-flex w-fit rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white no-underline transition hover:bg-teal-800"
            href={withBase('/radiolink/')}
          >
            製品一覧を見る
          </a>
          <div class="mt-8 grid gap-3 sm:grid-cols-3">
            <a
              class="rounded-2xl bg-slate-50 p-4 no-underline hover:bg-teal-50"
              href={withBase('/manuals/')}
              data-home-resource="manuals"
            >
              <strong class="block text-slate-950">マニュアル</strong>
              <span class="mt-1 block text-sm text-slate-600">
                操作情報を確認
              </span>
            </a>
            <a
              class="rounded-2xl bg-slate-50 p-4 no-underline hover:bg-teal-50"
              href={withBase('/support/')}
              data-home-resource="support"
            >
              <strong class="block text-slate-950">サポート</strong>
              <span class="mt-1 block text-sm text-slate-600">
                FAQと相談窓口
              </span>
            </a>
            <a
              class="rounded-2xl bg-slate-50 p-4 no-underline hover:bg-teal-50"
              href={withBase('/radiolink/updates/')}
              data-home-resource="updates"
            >
              <strong class="block text-slate-950">更新情報</strong>
              <span class="mt-1 block text-sm text-slate-600">
                製品の新着情報
              </span>
            </a>
          </div>
        </article>
        <article
          id="industry-technology"
          class="flex h-full flex-col rounded-3xl border border-slate-200 border-t-4 border-t-slate-900 bg-white p-7 shadow-sm sm:p-9"
          data-home-pillar="industry-technology"
        >
          <p class="m-0 text-sm font-bold tracking-[0.16em] text-teal-700 uppercase">
            Industry & Technology
          </p>
          <h2 class="mt-3 mb-0 text-3xl font-bold text-slate-950 sm:text-4xl">
            業界・技術
          </h2>
          <p class="mt-5 text-lg leading-8 text-slate-600">
            航空・ドローン分野の動向、RC技術、法規や導入事例を、製品紹介とは分けて背景から整理します。
          </p>
          <a
            class="mt-3 inline-flex w-fit rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white no-underline transition hover:bg-teal-800"
            href={withBase('/insights/')}
          >
            記事一覧を見る
          </a>
          <ul
            class="mt-8 flex list-none flex-wrap gap-2 p-0"
            aria-label="業界・技術のトピック"
          >
            {insightTopics.map((topic) => (
              <li class="rounded-full border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-semibold text-slate-700">
                {topic}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[var(--site-max-width)] px-5 py-16 lg:px-8 lg:py-24">
    <SectionHeading
      eyebrow="Featured Products"
      title="製品情報から探す"
      description="公開中の商品情報から、代表的な送信機と受信機を紹介します。全83製品は製品一覧から確認できます。"
    />
    <div class="mt-10 grid gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {featuredProducts.map((product) => (
        <div data-home-featured-product>
          <ProductCard product={product} />
        </div>
      ))}
    </div>
    <a
      class="mt-8 inline-block font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
      href={withBase('/radiolink/')}
    >
      すべての製品を見る
    </a>
  </section>

  <section class="border-y border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-16 lg:px-8 lg:py-24">
      <SectionHeading
        eyebrow="Industry & Technology"
        title="業界・技術を読む"
        description="製品の使い方だけでなく、その背景にある技術や業界の動きを公開情報から読み解きます。"
      />
      {insights.length ? (
        <div class="mt-10">
          {insights.map((insight) => (
            <InsightCard insight={insight} />
          ))}
        </div>
      ) : (
        <div
          class="mt-10 rounded-2xl border border-slate-200 bg-white p-6"
          data-insights-empty
        >
          <h3 class="m-0 text-xl font-bold text-slate-950">
            記事は順次掲載します。
          </h3>
          <p class="mb-0 text-slate-600">
            航空・RC・ドローン分野の技術や業界動向を、公開情報に基づいて紹介します。
          </p>
        </div>
      )}
      <a
        class="mt-8 inline-block font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
        href={withBase('/insights/')}
      >
        すべての記事を見る
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-[var(--site-max-width)] px-5 py-16 lg:px-8 lg:py-24">
    <SectionHeading eyebrow="Updates" title="製品アップデート" />
    <ul class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
      {updates.map(({ data }) => (
        <li class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr]">
          <time
            class="text-sm font-semibold text-slate-500"
            datetime={data.published_at.toISOString()}
          >
            {data.published_at.toLocaleDateString('ja-JP')}
          </time>
          <a
            class="font-bold text-slate-900"
            href={data.source_url}
            rel="noreferrer"
          >
            {data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
