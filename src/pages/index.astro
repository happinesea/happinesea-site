---
import { getCollection } from 'astro:content';
import HomeArticle from '../components/HomeArticle.astro';
import SectionHeading from '../components/SectionHeading.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import { SITE_NAME, SITE_TAGLINE } from '../lib/site';

const insights = [
  ...(await getCollection('insights')).filter(
    ({ data }) => data.content_status === 'published',
  ),
  ...(await getCollection('wordpressInsights')),
].sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());
const latest = insights[0];
// Presentation groups reuse existing editorial topics; taxonomy is unchanged.
const rcTopics = ['RC技術', '航空・ドローン'];
const news = insights
  .filter(({ data }) => !rcTopics.includes(data.topic))
  .slice(0, 3);
const rcArticles = insights
  .filter(
    ({ data }) =>
      rcTopics.includes(data.topic) && data.slug !== latest?.data.slug,
  )
  .slice(0, 3);
const resources = [
  { label: '製品を探す', href: '/radiolink/' },
  { label: 'マニュアル', href: '/manuals/', key: 'manuals' },
  { label: 'FAQ・サポート', href: '/support/', key: 'support' },
  { label: '更新情報', href: '/radiolink/updates/', key: 'updates' },
];
---

<BaseLayout>
  <section class="border-b border-slate-200 bg-slate-50" data-home-brand>
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-10 lg:px-8 lg:py-12">
      <p class="m-0 text-sm font-bold tracking-widest text-teal-700">
        {SITE_NAME}
      </p>
      <h1 class="mt-3 mb-0 text-4xl leading-tight font-bold text-slate-950 sm:text-5xl">
        {SITE_TAGLINE}
      </h1>
      <p class="mt-4 mb-0 max-w-2xl text-lg leading-8 text-slate-600">
        航空・RC・ドローンを楽しむための、知識と使い方、設計図を探せます。
      </p>
    </div>
  </section>

  <section
    class="mx-auto max-w-[var(--site-max-width)] px-5 py-10 lg:px-8 lg:py-12"
    data-home-section="latest"
  >
    <p class="mt-0 mb-5 text-sm font-semibold text-teal-700">最新記事</p>
    {latest ? (
      <HomeArticle insight={latest} featured />
    ) : (
      <a href={withBase('/insights/')}>記事一覧を見る</a>
    )}
  </section>

  <section
    class="border-y border-slate-200 bg-slate-50"
    data-home-section="news"
  >
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16">
      <SectionHeading title="ニュース・航空知識" />
      <div
        class:list={['mt-8 grid gap-8', news.length > 1 && 'md:grid-cols-3']}
      >
        {news.map((insight) => (
          <HomeArticle insight={insight} horizontal={news.length === 1} />
        ))}
      </div>
      <a
        class="mt-6 inline-block font-bold text-teal-800 underline underline-offset-4"
        href={withBase('/insights/')}
      >
        記事一覧を見る
      </a>
    </div>
  </section>

  <section
    class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16"
    data-home-section="rc-drone"
  >
    <SectionHeading title="RC・ドローン" />
    <div class="mt-8 grid gap-8 md:grid-cols-3">
      {rcArticles.map((insight) => (
        <HomeArticle insight={insight} />
      ))}
    </div>
    <a
      class="mt-6 inline-block font-bold text-teal-800 underline underline-offset-4"
      href={withBase('/insights/')}
    >
      使い方の記事を探す
    </a>
  </section>

  <section
    class="border-y border-slate-200 bg-slate-50"
    data-home-section="drawings"
  >
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16">
      <SectionHeading
        title="設計図ライブラリ"
        description="飛行機などの設計図を探す。"
      />
      <a
        class="mt-6 inline-block rounded-full bg-slate-950 px-6 py-3 font-semibold text-white no-underline hover:bg-teal-800"
        href="https://happinesea.com/drawinglibrary"
      >
        設計図を見る
      </a>
    </div>
  </section>

  <section
    class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16"
    data-home-section="glossary"
  >
    <SectionHeading
      title="基本用語集"
      description="ラジコン・ドローンの用語を調べる。"
    />
    <a
      class="mt-6 inline-block font-bold text-teal-800 underline underline-offset-4"
      href="https://happinesea.com/drone-rc-glossary"
    >
      基本用語集を見る
    </a>
  </section>

  <section
    class="border-t border-slate-200 bg-slate-50"
    data-home-section="radiolink"
  >
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16">
      <SectionHeading
        eyebrow="Radiolink"
        title="製品・マニュアル・サポート"
        description="製品の仕様や操作方法、よくある質問、更新情報を確認できます。"
      />
      <ul class="mt-8 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-4">
        {resources.map((resource) => (
          <li>
            <a
              class="block rounded-xl border border-slate-200 bg-white px-5 py-5 font-bold text-teal-800 no-underline hover:border-teal-500"
              href={withBase(resource.href)}
              data-home-resource={resource.key}
            >
              {resource.label}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
