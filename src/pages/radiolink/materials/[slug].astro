---
import catalogue from '../../../data/product-catalogue.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  fullSourceUnavailable,
  productDetailPath,
  productMaterialLinks,
} from '../../../lib/product-materials.mjs';
import { withBase } from '../../../lib/urls';

export function getStaticPaths() {
  return catalogue
    .filter((product) =>
      productDetailPath(product).startsWith('/radiolink/materials/'),
    )
    .map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const links = productMaterialLinks(product);
---

<BaseLayout
  title={'Radiolink ' + product.name}
  description={product.description}
>
  <article class="mx-auto max-w-[var(--site-max-width)] px-5 py-12">
    <a href={withBase('/radiolink/#products')}>製品一覧へ戻る</a>
    <p class="mt-6 text-sm font-bold text-teal-700">{product.category}</p>
    <h1 class="text-3xl font-bold">Radiolink {product.name}</h1>
    <p>{product.description}</p>
    <img
      src={withBase(product.image.src)}
      width={product.image.width}
      height={product.image.height}
      alt={'Radiolink ' + product.name}
      class="my-8 max-h-72 w-full object-contain"
    />
    <h2 class="text-2xl font-bold">取扱説明書・サポート</h2>
    {fullSourceUnavailable(product.slug) && (
      <p class="mt-3">
        この型番に対応する公式の全文取扱説明書は確認できていません。
      </p>
    )}
    <ul class="mt-3 list-disc space-y-2 pl-6">
      {links.map((link) => (
        <li>
          <a
            href={link.external ? link.href : withBase(link.href)}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-5">
      <a href={withBase('/support/')}>サポート・FAQ</a>
    </p>
  </article>
</BaseLayout>
