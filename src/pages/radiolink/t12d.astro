---
import { getEntry } from 'astro:content';
import StandardProductPage from '../../components/StandardProductPage.astro';
import { withBase } from '../../lib/urls';
import pages from '../../data/standard-product-pages.json';
import manuals from '../../lib/receiver-manuals.mjs';
import { canShowGeneratedManual } from '../../lib/product-materials.mjs';

const product = await getEntry('products', 't12d');
if (!product) throw new Error('T12D product data is missing');
const manual = manuals.manuals.find((entry) => entry.product_id === 't12d');
---

<StandardProductPage product={product} detail={pages.t12d}>
  {manual && canShowGeneratedManual(manual) && (
    <a slot="manual-link" href={withBase('/manuals/t12d/')}>
      日本語取扱説明書
    </a>
  )}
</StandardProductPage>
