---
import { getCollection } from 'astro:content';
import SectionHeading from '../../../components/SectionHeading.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';

const updates = (await getCollection('productUpdates')).sort(
  (a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf(),
);
---

<BaseLayout
  title="Radiolink更新情報"
  description="Radiolink製品のファームウェアやマニュアルの更新、メーカーからのお知らせを確認できます。"
>
  <section
    class="mx-auto max-w-[var(--site-max-width)] px-5 py-14 lg:px-8 lg:py-20"
    data-content-kind="product_update"
  >
    <SectionHeading
      eyebrow="Radiolink"
      title="Radiolink更新情報"
      level="h1"
      description="ファームウェアやマニュアルの更新、メーカーからのお知らせはこちら。"
    />
    <ul class="mt-10 divide-y divide-slate-200 border-y border-slate-200">
      {updates.map(({ data }) => (
        <li class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr]">
          <time
            class="text-sm font-semibold text-slate-500"
            datetime={data.published_at.toISOString()}
          >
            {data.published_at.toLocaleDateString('ja-JP')}
          </time>
          <a
            class="font-bold text-slate-900"
            href={data.source_url}
            rel="noreferrer"
          >
            {data.title}
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
