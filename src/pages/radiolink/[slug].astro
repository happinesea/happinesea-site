---
import { getCollection, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DefinitionTable from '../../components/DefinitionTable.astro';
import ManualVideo from '../../components/manuals/ManualVideo.astro';
import ProductHero from '../../components/ProductHero.astro';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import UnverifiedNotice from '../../components/UnverifiedNotice.astro';
import rc8xPage from '../../data/rc8x-page.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildBreadcrumbJsonLd, buildProductJsonLd } from '../../lib/structured-data';
import { canonicalUrl, withBase } from '../../lib/urls';

interface Props {
  product: CollectionEntry<'products'>;
}

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product } }));
}

const { product } = Astro.props;
const { data } = product;
const detail = rc8xPage;
const updates = (await getCollection('productUpdates')).filter(
  (entry) => entry.data.product === data.slug,
);
const productUrl = canonicalUrl(`/radiolink/${data.slug}/`);
const breadcrumbItems = [
  { label: 'ホーム', href: withBase('/') },
  { label: 'Radiolink製品', href: withBase('/radiolink/') },
  { label: data.model },
];
const jsonLd = [
  buildBreadcrumbJsonLd([
    { name: 'ホーム', url: canonicalUrl('/') },
    { name: 'Radiolink製品', url: canonicalUrl('/radiolink/') },
    { name: data.model, url: productUrl },
  ]),
  buildProductJsonLd({
    name: data.title,
    description: data.description,
    manufacturer: data.manufacturer,
    model: data.model,
    url: productUrl,
  }),
];
const row = ([label, value]: string[]) => ({ label, value, status: 'verified' as const });
const featuredVideos = detail.videos.slice(0, 6);
const moreVideos = detail.videos.slice(6);
const featureCardGroups = [
  {
    label: 'カスタマイズ / UI',
    ids: ['wallpaper', 'theme-customization', 'voice-customization', 'voice-broadcast', 'channel-customization', 'switch-customization', 'languages'],
  },
  {
    label: '運用 / 表示 / モデル管理',
    ids: ['fpv-display', 'model-storage', 'cruise-control', 'dual-rate'],
  },
  {
    label: '操作性 / 拡張 / ハードウェア',
    ids: ['ergonomics', 'physical-options', 'power'],
  },
  {
    label: '付属受信機',
    ids: ['r8fg-stability-protection'],
  },
];
const cardFeatureIds = new Set(featureCardGroups.flatMap(({ ids }) => ids));
const cardOrder = new Map(
  featureCardGroups.flatMap(({ ids }) => ids).map((id, index) => [id, index]),
);
const cardFeatures = detail.features
  .filter(({ id }) => cardFeatureIds.has(id))
  .sort((a, b) => cardOrder.get(a.id)! - cardOrder.get(b.id)!);
const otherFeatures = detail.features.filter(({ id }) => !cardFeatureIds.has(id));
const cardInsertionIndex = otherFeatures.findIndex(({ id }) => id === 'customization') + 1;
const orderedFeatures = [
  ...otherFeatures.slice(0, cardInsertionIndex),
  ...cardFeatures,
  ...otherFeatures.slice(cardInsertionIndex),
];
const groupLabelByFirstFeature = new Map(
  featureCardGroups.map(({ label, ids }) => [ids[0], label]),
);
---

<BaseLayout
  title={`${data.manufacturer} ${data.model}`}
  description={data.description}
  canonicalPath={`/radiolink/${data.slug}/`}
  jsonLd={jsonLd}
  robots={data.content_status === 'manufacturer_review' ? 'noindex, nofollow' : undefined}
>
  <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-6 lg:px-8">
    <Breadcrumbs items={breadcrumbItems} />
    <ProductHero product={data} copy={detail.hero} />
    {data.content_status === 'manufacturer_review' && (
      <UnverifiedNotice
        text={data.review_note ?? 'この商品情報はメーカー確認中です。確認完了までは確定仕様として扱わないでください。'}
      />
    )}

    <nav
      aria-label="RC8Xページ内ナビゲーション"
      class="sticky top-[4.5rem] z-30 -mx-5 mt-8 overflow-x-auto border-y border-slate-200 bg-white/95 px-5 backdrop-blur lg:-mx-8 lg:px-8"
      data-product-nav
    >
      <ul class="mx-auto flex w-max min-w-full list-none items-center gap-1 p-2 text-sm font-bold">
        {[
          ['RC8X', '#overview'], ['仕様', '#specifications'],
          ['証明書', '#certificates'], ['Firmware', '#firmware'], ['チュートリアル', '#videos'], ['FAQ', '#faq'],
        ].map(([label, href]) => (
          <li><a class="block rounded-full px-4 py-2 text-slate-700 no-underline hover:bg-teal-50 hover:text-teal-800" href={href}>{label}</a></li>
        ))}
      </ul>
    </nav>

    <main class="mx-auto max-w-5xl" id="overview">
      <section class="py-16" aria-labelledby="feature-summary-heading">
        <p class="m-0 text-sm font-bold tracking-[0.14em] text-teal-700 uppercase">Product overview</p>
        <h2 id="feature-summary-heading" class="mt-2 text-3xl font-bold text-slate-950">RC8X</h2>
        <ul class="mt-8 grid list-none gap-px overflow-hidden rounded-3xl border border-slate-200 bg-slate-200 p-0 sm:grid-cols-2 lg:grid-cols-3">
          {detail.feature_metrics.map((metric) => <li class="bg-white p-5 font-bold text-slate-800">{metric}</li>)}
        </ul>
        <p class="mt-3 text-sm text-slate-500">※出荷時は8チャンネル。Firmware V1.3.5以上で16チャンネルへ拡張できます。</p>
      </section>

      <section id="features" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-product-section="features" aria-labelledby="features-heading">
        <h2 id="features-heading" class="sr-only">RC8X</h2>
        {orderedFeatures.map((feature, index) => (
          <>
            {groupLabelByFirstFeature.has(feature.id) && (
              <div class="col-span-full mt-8 border-t border-slate-200 pt-10">
                <p class="m-0 text-sm font-bold tracking-[0.12em] text-teal-700 uppercase">
                  {groupLabelByFirstFeature.get(feature.id)}
                </p>
              </div>
            )}
            <article
            id={feature.id}
            class:list={[
              'scroll-mt-36',
              cardFeatureIds.has(feature.id)
                ? 'flex flex-col rounded-3xl border border-slate-200 bg-slate-50 p-5'
                : 'col-span-full grid gap-8 border-t border-slate-200 py-14 md:grid-cols-2 md:items-center md:gap-12',
            ]}
            data-feature-section={feature.id}
            data-feature-layout={cardFeatureIds.has(feature.id) ? 'tile' : 'split'}
          >
            <div
              class:list={{
                'md:order-2':
                  !cardFeatureIds.has(feature.id) && index % 2 === 1 && 'media' in feature && feature.media,
                'md:col-span-2 md:max-w-3xl':
                  !('media' in feature && feature.media),
              }}
            >
              <p class="m-0 text-sm font-bold text-teal-700">{feature.lead}</p>
              <h3 class:list={['mt-2 font-bold tracking-tight text-slate-950', cardFeatureIds.has(feature.id) ? 'text-2xl' : 'text-3xl']}>{feature.title}</h3>
              <p class="mt-5 text-slate-600">{feature.description}</p>
              {feature.points.length > 0 && (
                <ul class="mt-5 space-y-2 pl-5 text-slate-700">
                  {feature.points.map((point) => <li>{point}</li>)}
                </ul>
              )}
            </div>
            {'media' in feature && feature.media && (
              <figure class:list={[
                'm-0 grid place-items-center overflow-hidden',
                cardFeatureIds.has(feature.id)
                  ? 'order-first mb-5 aspect-[4/3] [&_img]:max-h-64 [&_img]:rounded-2xl'
                  : 'max-h-80 [&_img]:max-h-80 [&_img]:rounded-2xl',
                { 'md:order-1': !cardFeatureIds.has(feature.id) && index % 2 === 1 },
              ]}>
                <ResponsiveMedia media={{ ...feature.media, image_status: 'verified' }} />
              </figure>
            )}
            </article>
          </>
        ))}
      </section>

      <section class="border-t border-slate-200 py-16" data-product-section="package">
        <div class="grid gap-8 md:grid-cols-2 md:items-start md:gap-12">
          <div>
            <p class="m-0 text-sm font-bold text-teal-700">RC8X Packing List</p>
            <h2 class="mt-2 text-3xl font-bold text-slate-950">パッケージ内容</h2>
            <p class="text-slate-600">実際の同梱品は購入した販売ページ、または販売店で確認してください。</p>
            <ul class="mt-5 grid gap-x-8 pl-5 sm:grid-cols-2 md:grid-cols-1">
              {data.package_contents.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <ResponsiveMedia media={{ ...detail.package_media, image_status: 'verified' }} />
        </div>
      </section>

      <section id="specifications" class="scroll-mt-36 border-t border-slate-200 py-16" data-product-section="specifications">
        <p class="m-0 text-sm font-bold text-teal-700">Specifications</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-950">仕様</h2>
        <h3 class="mt-10 text-2xl font-bold text-slate-950">RC8X仕様</h3>
        <DefinitionTable rows={detail.rc8x_specifications.map(row)} />
        <h3 class="mt-12 text-2xl font-bold text-slate-950">R8FG仕様</h3>
        <DefinitionTable rows={detail.r8fg_specifications.map(row)} />
      </section>

      <section id="certificates" class="scroll-mt-36 border-t border-slate-200 py-16" data-product-section="certificates">
        <p class="m-0 text-sm font-bold text-teal-700">Certificates</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-950">認証・証明書</h2>
        <p class="max-w-3xl text-slate-600">CE、RoHS、FCC、MIC、SRRCの資料はRadiolink公式ページで確認できます。</p>
        <a
          class="mt-5 inline-flex rounded-full border border-slate-300 px-5 py-3 font-bold text-teal-800 no-underline"
          href={detail.source.certificates_url}
          target="_blank"
          rel="noopener noreferrer"
        >Radiolink公式の証明書ページを開く</a>
      </section>

      <section id="firmware" class="scroll-mt-36 border-t border-slate-200 py-16" data-product-section="firmware">
        <p class="m-0 text-sm font-bold text-teal-700">Latest Firmware</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-950">Firmware</h2>
        <p class="max-w-3xl text-slate-600">WindowsはType-C接続、MacはMicroSDカードを取り外してカードリーダーを使う方法が公式に案内されています。complete packageは設定を初期化し、fix packageは現在のカスタマイズを維持する用途です。</p>
        <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
          {detail.firmware.map((release) => (
            <article class="grid gap-3 py-6 sm:grid-cols-[8rem_1fr]">
              <div>
                <h3 class="m-0 text-xl font-bold text-slate-950">{release.version}</h3>
                {release.date && <time class="text-sm text-slate-500">{release.date}</time>}
              </div>
              <ul class="m-0 pl-5 text-slate-700">{release.notes.map((note) => <li>{note}</li>)}</ul>
            </article>
          ))}
        </div>
        <a class="mt-6 inline-flex font-bold text-teal-800" href={detail.source.firmware_url} target="_blank" rel="noopener noreferrer">Radiolink公式Firmwareページを開く</a>
      </section>

      <section id="videos" class="scroll-mt-36 border-t border-slate-200 py-16" data-product-section="videos">
        <p class="m-0 text-sm font-bold text-teal-700">Tutorial videos</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-950">チュートリアル</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-2">
          {featuredVideos.map(([youtubeId, title]) => (
            <ManualVideo youtubeId={youtubeId} title={title} description="Radiolink公式チュートリアル" />
          ))}
        </div>
        <details class="mt-8 rounded-2xl border border-slate-200 p-5">
          <summary class="cursor-pointer font-bold text-slate-950">チュートリアル動画をさらに表示する（{moreVideos.length}本）</summary>
          <ol class="mt-5 grid gap-3 pl-6 md:grid-cols-2">
            {moreVideos.map(([youtubeId, title]) => (
              <li><a class="text-teal-800" href={`https://www.youtube.com/watch?v=${youtubeId}`} target="_blank" rel="noopener noreferrer">{title}</a></li>
            ))}
          </ol>
        </details>
      </section>

      <section id="faq" class="scroll-mt-36 border-t border-slate-200 py-16" data-product-section="faq">
        <p class="m-0 text-sm font-bold text-teal-700">Frequently asked questions</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-950">FAQ</h2>
        <div class="mt-8 divide-y divide-slate-200 border-y border-slate-200">
          {detail.faq.map(([question, answer]) => (
            <details class="group py-5" data-product-faq>
              <summary class="cursor-pointer list-none pr-8 font-bold text-slate-950 marker:content-none">{question}</summary>
              <p class="mb-0 max-w-4xl text-slate-600">{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="border-t border-slate-200 py-16" data-product-section="updates">
        <p class="m-0 text-sm font-bold text-teal-700">Updates</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-950">Radiolink更新情報</h2>
        {updates.length ? (
          <ul class="m-0 mt-6 list-none p-0">
            {updates.map(({ data: update }) => (
              <li class="grid gap-2 border-b border-slate-200 py-3 sm:grid-cols-[7rem_1fr]">
                <time datetime={update.published_at.toISOString()}>{update.published_at.toLocaleDateString('ja-JP')}</time>
                <a href={update.source_url} target="_blank" rel="noopener noreferrer">{update.title}</a>
              </li>
            ))}
          </ul>
        ) : <UnverifiedNotice />}
        <a class="mt-6 inline-flex font-bold text-teal-800" href={withBase('/radiolink/updates/')}>Radiolink更新情報をすべて見る</a>
      </section>
    </main>
  </div>
</BaseLayout>
