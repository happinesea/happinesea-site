---
import { getEntry } from 'astro:content';
import StandardProductPage from '../../components/StandardProductPage.astro';
import pages from '../../data/standard-product-pages.json';

const product = await getEntry('products', 'rc8p');
if (!product) throw new Error('RC8P product data is missing');
---

<StandardProductPage product={product} detail={pages.rc8p} />
