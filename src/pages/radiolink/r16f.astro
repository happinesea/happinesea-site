---
import { getEntry } from 'astro:content';
import StandardProductPage from '../../components/StandardProductPage.astro';
import pages from '../../data/standard-product-pages.json';
import { withBase } from '../../lib/urls';

const product = await getEntry('products', 'r16f');
if (!product) throw new Error('R16F product data is missing');
---

<StandardProductPage product={product} detail={pages.r16f}>
  <p slot="manual-link" class="mt-6">
    <a
      href={withBase('/manuals/r16f/')}
      data-receiver-manual-link
      class="font-bold text-teal-800 underline"
    >
      日本語取扱説明書
    </a>
  </p>
</StandardProductPage>
