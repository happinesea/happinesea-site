---
import { getCollection } from 'astro:content';
import CategoryFilter from '../../components/CategoryFilter.astro';
import ProductCard from '../../components/ProductCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const products = await getCollection('products');
---

<BaseLayout
  title="Radiolink製品"
  description="Radiolink製品の公開情報をカテゴリから探せる一覧です。"
>
  <section class="border-b border-slate-200 bg-slate-50">
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-14 lg:px-8 lg:py-20">
      <SectionHeading
        eyebrow="Product Catalogue"
        title="Radiolink製品"
        level="h1"
        description="現在確認できている公開情報を掲載しています。カテゴリを選ぶと該当製品だけを表示します。"
      />
    </div>
  </section>
  <section class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16">
    <CategoryFilter total={products.length} />
    <div
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
      data-product-catalogue
    >
      {products.map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
</BaseLayout>
