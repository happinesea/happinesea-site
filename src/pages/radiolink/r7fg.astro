---
import { getEntry } from 'astro:content';
import StandardProductPage from '../../components/StandardProductPage.astro';
import pages from '../../data/standard-product-pages.json';

const product = await getEntry('products', 'r7fg');
if (!product) throw new Error('R7FG product data is missing');
---

<StandardProductPage product={product} detail={pages.r7fg} />
