---
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';
import existingJapaneseManuals from '../../data/manuals/existing-ja.json';
---

<BaseLayout
  title="Radiolink製品マニュアル"
  description="Radiolink製品の操作方法を日本語マニュアルで確認できます。"
>
  <section class="border-b border-slate-200 bg-slate-50" data-manual-index>
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-14 lg:px-8 lg:py-20">
      <SectionHeading
        eyebrow="Radiolink"
        title="製品マニュアル"
        level="h1"
        description="製品の操作方法を日本語マニュアルで確認できます。"
      />
      <article class="mt-10 max-w-3xl rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
        <h2 class="mt-0 text-3xl font-bold text-slate-950">
          RC4GS V2 日本語マニュアル
        </h2>
        <p class="mt-4 text-slate-600">
          送信機・受信機と各機能を、第1章・第2章の目次から確認できます。RC4GS
          V3以降とは対象が異なります。
        </p>
        <a
          class="mt-3 inline-block rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white no-underline hover:bg-teal-800"
          href={withBase('/manuals/rc4gs-v2/')}
        >
          RC4GS V2マニュアルを見る
        </a>
      </article>
      {existingJapaneseManuals.manuals
        .filter((manual) => manual.publication_status === 'publication_copy')
        .map((manual) => (
          <article
            class="mt-8 max-w-3xl rounded-3xl border border-slate-200 bg-white p-7 sm:p-9"
            data-existing-japanese-manual={manual.id}
          >
            <h2 class="m-0 text-2xl font-bold text-slate-950">
              {manual.title}
            </h2>
            <p class="mt-4 text-slate-600">
              {manual.document_type === 'quick_reference'
                ? '操作の要点を確認するクイックリファレンスです。'
                : '既存の日本語取扱説明書の本文と図版を確認できます。'}
            </p>
            <a
              class="mt-3 inline-block rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white no-underline hover:bg-teal-800"
              href={withBase(manual.route)}
            >
              {manual.title}を見る
            </a>
          </article>
        ))}
      <article class="mt-10 max-w-3xl rounded-3xl border border-slate-200 bg-white p-7 shadow-sm sm:p-9">
        <p class="m-0 text-sm font-bold tracking-[0.16em] text-teal-700 uppercase">
          Radiolink
        </p>
        <h2 class="mt-3 mb-0 text-3xl font-bold text-slate-950">
          RC8X 日本語マニュアル
        </h2>
        <p class="mt-4 text-slate-600">
          現在は概要、第1章、第2章を掲載しています。
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            class="rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white no-underline hover:bg-teal-800"
            href={withBase('/manuals/rc8x/')}
          >
            RC8Xマニュアルを見る
          </a>
          <a
            class="rounded-full border border-slate-300 px-5 py-3 text-sm font-bold text-slate-900 no-underline hover:border-teal-700 hover:text-teal-800"
            href={withBase('/radiolink/rc8x/')}
          >
            RC8Xの商品情報を見る
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
