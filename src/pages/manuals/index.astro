---
import SectionHeading from '../../components/SectionHeading.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';
import { manualCards } from '../../lib/manual-directory.mjs';

const categories = [...new Set(manualCards.map((card) => card.category))];
---

<BaseLayout
  title="Radiolink製品 取扱説明書"
  description="Radiolink製品の日本語取扱説明書と公式サイトの英語版を、機種から探せます。"
>
  <section class="border-b border-slate-200 bg-slate-50" data-manual-index>
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-14 lg:px-8 lg:py-20">
      <SectionHeading
        eyebrow="Radiolink"
        title="取扱説明書"
        level="h1"
        description="機種と製品世代に合った取扱説明書を選べます。日本語版と公式サイトの英語版をまとめています。"
      />
    </div>
  </section>
  <section
    class="mx-auto max-w-[var(--site-max-width)] px-5 py-12 lg:px-8 lg:py-16"
    aria-label="機種別の取扱説明書"
  >
    <CategoryFilter
      total={manualCards.length}
      categories={categories}
      label="取扱説明書のカテゴリで絞り込む"
    />
    <div
      class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"
      data-product-catalogue
    >
      {manualCards.map((card) => (
        <article
          class="flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
          data-manual-card={card.id}
          data-product-category={card.category}
        >
          <figure class="m-0 border-b border-slate-100 p-6">
            <img
              class="aspect-[4/3] h-auto w-full object-contain"
              src={withBase(card.image.src)}
              width={card.image.width}
              height={card.image.height}
              alt={`Radiolink ${card.imageLabel}`}
              loading="lazy"
              decoding="async"
            />
            <figcaption class="mt-2 text-center text-xs text-slate-500">
              {card.imageLabel}
            </figcaption>
          </figure>
          <div class="flex flex-1 flex-col p-6">
            <p class="m-0 text-xs font-bold text-teal-700">{card.category}</p>
            <h2 class="mt-2 mb-0 text-2xl font-bold text-slate-950">
              {card.name}
            </h2>
            <p class="mt-3 mb-5 text-sm leading-6 text-slate-600">
              {card.description}
            </p>
            <div
              class="mt-auto flex flex-col gap-2"
              aria-label={`${card.name}の取扱説明書`}
            >
              {card.links.map((link) => (
                <a
                  class:list={[
                    'flex min-h-11 items-center justify-center rounded-xl border px-4 py-3 text-center text-sm font-bold no-underline transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-700',
                    link.external
                      ? 'border-slate-300 bg-white text-teal-800 hover:border-teal-700 hover:bg-teal-50'
                      : 'border-slate-950 bg-slate-950 text-white hover:border-teal-800 hover:bg-teal-800',
                  ]}
                  href={link.external ? link.href : withBase(link.href)}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                  data-existing-japanese-manual={
                    link.external ? undefined : link.id
                  }
                >
                  {link.label}
                  {link.external && (
                    <span class="sr-only">（新しいタブで開きます）</span>
                  )}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
