---
import { getCollection } from 'astro:content';
import LineCta from '../../components/LineCta.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

const entries = await getCollection('support');
---

<BaseLayout
  title="Radiolink製品サポート"
  description="Radiolink製品の使い方やよくある質問、LINE相談窓口はこちら。"
>
  <section class="mx-auto max-w-[var(--site-max-width)] px-5 py-14 lg:px-8 lg:py-20">
    <SectionHeading
      eyebrow="Radiolink"
      title="製品サポート"
      level="h1"
      description="製品情報とマニュアルを確認し、解決しない場合はLINEからお問い合わせください。"
    />
    <div class="mt-10 grid gap-8 lg:grid-cols-[1fr_22rem]">
      <div>
        {entries.map(({ data }) => (
          <article class="rounded-2xl border border-slate-200 p-6">
            <h2 class="m-0 text-2xl font-bold text-slate-950">{data.title}</h2>
            <p class="text-slate-600">{data.description}</p>
            <div class="my-6 flex flex-wrap gap-3">
              <a
                class="rounded-full bg-slate-950 px-5 py-3 text-sm font-bold text-white no-underline hover:bg-teal-800"
                href={withBase('/radiolink/rc8x/')}
              >
                RC8Xの商品情報を見る
              </a>
              <a
                class="rounded-full border border-slate-300 px-5 py-3 text-sm font-bold text-slate-900 no-underline hover:border-teal-700 hover:text-teal-800"
                href={withBase('/manuals/rc8x/')}
              >
                RC8Xマニュアルを見る
              </a>
            </div>
            {data.faq.length ? (
              <dl>
                {data.faq.map((item) => (
                  <>
                    <dt class="font-bold">{item.question}</dt>
                    <dd>{item.answer}</dd>
                  </>
                ))}
              </dl>
            ) : (
              <p class="rounded-xl bg-slate-50 p-4 text-sm text-slate-600">
                RC8Xのよくある質問は商品ページで確認できます。マニュアルでも解決しない場合は、LINEからお問い合わせください。
              </p>
            )}
          </article>
        ))}
      </div>
      <LineCta />
    </div>
  </section>
</BaseLayout>
