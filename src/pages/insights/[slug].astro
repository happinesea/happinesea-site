---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleHero from '../../components/ArticleHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import UnverifiedNotice from '../../components/UnverifiedNotice.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
} from '../../lib/structured-data';
import { canonicalUrl, withBase } from '../../lib/urls';
import { SITE_NAME } from '../../lib/site';
import manual from '../../data/manuals/rc4gs-v2.json';
import downloads from '../../data/static-downloads.json';
import { rewriteSafetyBlockedDownloads } from '../../../scripts/lib/existing-ja-manuals.mjs';
import {
  manualCanonical,
  migratedManualTarget,
} from '../../../scripts/lib/rc4gs-v2-manual.mjs';

interface Props {
  article: CollectionEntry<'insights'> | CollectionEntry<'wordpressInsights'>;
}

export async function getStaticPaths() {
  const insights = [
    ...(await getCollection('insights')),
    ...(await getCollection('wordpressInsights')),
  ];
  const slugs = new Set<string>();
  for (const { data } of insights) {
    const routeSlug = decodeURIComponent(data.slug);
    if (slugs.has(routeSlug))
      throw new Error(`Duplicate insight route: ${data.slug}`);
    slugs.add(routeSlug);
  }
  return insights.map((article) => ({
    params: { slug: decodeURIComponent(article.data.slug) },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data } = article;
const isWordpress = article.collection === 'wordpressInsights';
const wordpressData =
  article.collection === 'wordpressInsights' ? article.data : undefined;
const staticArticle = article.collection === 'insights' ? article : undefined;
const Content = staticArticle
  ? (await render(staticArticle)).Content
  : undefined;
const isPublished = data.content_status === 'published';
const routeUrl = canonicalUrl(`/insights/${data.slug}/`);
const manualTarget =
  wordpressData && migratedManualTarget(wordpressData.canonical, manual);
const articleUrl = wordpressData
  ? manualCanonical(wordpressData.canonical, manual)
  : routeUrl;
const kind =
  data.article_kind === 'technical_explainer' ? 'TechArticle' : 'Article';
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'ホーム', url: canonicalUrl('/') },
  { name: 'ニュース・航空知識', url: canonicalUrl('/insights/') },
  { name: data.title, url: routeUrl },
]);
const jsonLd = isPublished
  ? [
      breadcrumbJsonLd,
      buildArticleJsonLd({
        kind,
        headline: data.title,
        description: data.description,
        url: articleUrl,
        datePublished: data.published_at.toISOString(),
        dateModified: data.updated_at.toISOString(),
        author: SITE_NAME,
      }),
    ]
  : breadcrumbJsonLd;
const description = isPublished
  ? data.description
  : 'この記事は現在お読みいただけません。ニュース・航空知識の一覧から、ほかの記事をご覧ください。';
const wordpressBody =
  wordpressData &&
  rewriteSafetyBlockedDownloads(
    wordpressData.content_html,
    downloads.files,
    withBase('/downloads/') + '#manual-safety-review',
  ).replaceAll(/href="([^"]+)"/g, (match, value: string) => {
    if (!manualTarget) return match;
    const target = migratedManualTarget(value, manual);
    return target ? `href="${withBase(target)}"` : match;
  });
---

<BaseLayout
  title={data.title}
  description={description}
  canonicalPath={`/insights/${data.slug}/`}
  canonicalUrlOverride={wordpressData ? articleUrl : undefined}
  image={wordpressData?.hero?.src}
  type={isPublished ? 'article' : 'website'}
  jsonLd={jsonLd}
  robots={wordpressData?.noindex ? 'noindex, nofollow' : undefined}
>
  <article class="mx-auto max-w-4xl px-5 py-6 [overflow-wrap:anywhere] lg:px-8">
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: withBase('/') },
        { label: 'ニュース・航空知識', href: withBase('/insights/') },
        { label: data.title },
      ]}
    />
    {isPublished ? (
      <>
        {manualTarget && (
          <p class="my-6 rounded-lg border border-teal-200 bg-teal-50 p-4">
            <a href={withBase(manualTarget)}>RC4GS V2 日本語マニュアルを読む</a>{' '}
            — このページの内容は新しいマニュアルへ移しました。
          </p>
        )}
        <ArticleHero article={data} />

        <section
          class="border-y border-slate-200 py-7 text-xl leading-9 text-slate-700"
          data-article-section="introduction"
        >
          <p>{data.description}</p>
        </section>

        <div
          class="prose prose-slate mt-10 max-w-none overflow-x-auto [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:max-w-full [&_iframe]:w-full [&_img]:h-auto [&_img]:max-w-full"
          data-article-section="body"
        >
          {isWordpress ? (
            <Fragment
              set:html={wordpressBody!.replaceAll(
                /\b(href|src)="(\/(?:assets\/insights\/wordpress|downloads|wp-content)\/[^"]+)"/g,
                (_, attr: string, src: string) => `${attr}="${withBase(src)}"`,
              )}
            />
          ) : (
            Content && <Content />
          )}
        </div>

        <section class="mt-12" data-article-section="related">
          <h2 class="text-2xl font-bold text-slate-950">関連情報</h2>
          <UnverifiedNotice text="関連する記事はありません。" />
        </section>

        <footer
          class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-600"
          data-article-section="attribution"
        >
          <p>編集: {SITE_NAME}</p>
          {isWordpress && (
            <p>
              <a
                href={
                  manualTarget
                    ? withBase(manualTarget)
                    : wordpressData!.canonical
                }
              >
                {manualTarget
                  ? 'RC4GS V2 日本語マニュアルを見る'
                  : '元の記事を見る'}
              </a>
            </p>
          )}
        </footer>
      </>
    ) : (
      <section class="py-10 lg:py-16" data-article-availability>
        <p class="mb-3 text-sm font-bold tracking-[0.14em] text-teal-700 uppercase">
          {data.topic}
        </p>
        <h1 class="m-0 max-w-4xl text-4xl leading-tight font-bold tracking-tight text-slate-950 sm:text-6xl">
          {data.title}
        </h1>
        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <h2 class="m-0 text-2xl font-bold text-slate-950">
            この記事は現在お読みいただけません。
          </h2>
          <p class="mt-3 text-slate-600">
            ニュース・航空知識の一覧から、ほかの記事をご覧ください。
          </p>
          <a
            class="mt-2 inline-block font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
            href={withBase('/insights/')}
          >
            ニュース・航空知識へ戻る
          </a>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
