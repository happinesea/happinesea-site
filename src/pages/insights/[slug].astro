---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleHero from '../../components/ArticleHero.astro';
import CmsArticleBody from '../../components/CmsArticleBody.astro';
import ArticleShare from '../../components/ArticleShare.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import UnverifiedNotice from '../../components/UnverifiedNotice.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
} from '../../lib/structured-data';
import { canonicalUrl, withBase } from '../../lib/urls';
import { SITE_NAME } from '../../lib/site';
import {
  articleExcerpt,
  cmsArticlePresentation,
  publishedCmsArticles,
  renderCmsArticlePages,
} from '../../../scripts/lib/pages-articles.mjs';
import catalogue from '../../data/product-catalogue.json';
import ResponsiveMedia from '../../components/ResponsiveMedia.astro';
import manual from '../../data/manuals/rc4gs-v2.json';
import downloads from '../../data/static-downloads.json';
import { rewriteSafetyBlockedDownloads } from '../../../scripts/lib/existing-ja-manuals.mjs';
import {
  manualCanonical,
  migratedManualTarget,
} from '../../../scripts/lib/rc4gs-v2-manual.mjs';

interface Props {
  cmsLead?: string;
  article:
    | CollectionEntry<'insights'>
    | CollectionEntry<'wordpressInsights'>
    | CollectionEntry<'cmsArticles'>;
}

export async function getStaticPaths() {
  const cmsArticles = await getCollection('cmsArticles');
  const draftPreview =
    import.meta.env.DEV && process.env.PUBLICATION_MODE !== 'production'
      ? cmsArticles.find(
          ({ data }) =>
            data.content_status === 'draft' &&
            data.slug === process.env.CMS_ARTICLE_LOCAL_PREVIEW,
        )
      : undefined;
  const insights = [
    ...(await getCollection('insights')),
    ...(await getCollection('wordpressInsights')),
    ...publishedCmsArticles(cmsArticles),
    ...(draftPreview ? [draftPreview] : []),
  ];
  const cmsLeads = new Map(
    cmsArticles.map(({ data }) => [data.slug, data.description]),
  );
  const slugs = new Set<string>();
  for (const { data } of insights) {
    const routeSlug = decodeURIComponent(data.slug);
    if (slugs.has(routeSlug))
      throw new Error(`Duplicate insight route: ${data.slug}`);
    slugs.add(routeSlug);
  }
  return insights.map((article) => ({
    params: { slug: decodeURIComponent(article.data.slug) },
    props: {
      article,
      cmsLead:
        article.collection === 'cmsArticles'
          ? cmsLeads.get(article.data.slug)
          : undefined,
    },
  }));
}

const { article, cmsLead = '' } = Astro.props;
const { data } = article;
const isWordpress = article.collection === 'wordpressInsights';
const wordpressData =
  article.collection === 'wordpressInsights' ? article.data : undefined;
const cmsData = article.collection === 'cmsArticles' ? article.data : undefined;
const staticArticle = article.collection === 'insights' ? article : undefined;

const relatedProducts =
  cmsData?.related_products.map((id) =>
    catalogue.find((product) => product.id === id)!,
  ) ?? [];
const Content = staticArticle
  ? (await render(staticArticle)).Content
  : undefined;
const isPublished = data.content_status === 'published';
const isDraftPreview =
  cmsData?.content_status === 'draft' && import.meta.env.DEV;
const cmsPages =
  cmsData && (isPublished || isDraftPreview)
    ? renderCmsArticlePages(article.body, import.meta.env.BASE_URL)
    : undefined;
const routeUrl = canonicalUrl(`/insights/${data.slug}/`);
const manualTarget =
  wordpressData && migratedManualTarget(wordpressData.canonical, manual);
const articleUrl = wordpressData
  ? manualCanonical(wordpressData.canonical, manual)
  : routeUrl;
const kind =
  data.article_kind === 'technical_explainer' ? 'TechArticle' : 'Article';
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'ホーム', url: canonicalUrl('/') },
  { name: 'ニュース・航空知識', url: canonicalUrl('/insights/') },
  { name: data.title, url: routeUrl },
]);
const jsonLd = isPublished
  ? [
      breadcrumbJsonLd,
      buildArticleJsonLd({
        kind,
        headline: data.title,
        description: data.description,
        url: articleUrl,
        datePublished: data.published_at.toISOString(),
        dateModified: data.updated_at.toISOString(),
        author: SITE_NAME,
      }),
    ]
  : breadcrumbJsonLd;
const description = isPublished
  ? data.description
  : isDraftPreview
    ? data.description || articleExcerpt(article.body) || data.title
    : 'この記事は現在お読みいただけません。ニュース・航空知識の一覧から、ほかの記事をご覧ください。';
const cmsPresentation = cmsPages
  ? cmsArticlePresentation(cmsPages, data.title, cmsLead)
  : undefined;
const wordpressBody =
  wordpressData &&
  rewriteSafetyBlockedDownloads(
    wordpressData.content_html,
    downloads.files,
    withBase('/downloads/') + '#manual-safety-review',
  ).replaceAll(/href="([^"]+)"/g, (match, value: string) => {
    if (!manualTarget) return match;
    const target = migratedManualTarget(value, manual);
    return target ? `href="${withBase(target)}"` : match;
  });
---

<BaseLayout
  title={data.title}
  description={description}
  canonicalPath={`/insights/${data.slug}/`}
  canonicalUrlOverride={wordpressData ? articleUrl : undefined}
  image={data.hero?.src ?? undefined}
  type={isPublished ? 'article' : 'website'}
  jsonLd={jsonLd}
  robots={
    !isPublished || wordpressData?.noindex ? 'noindex, nofollow' : undefined
  }
>
  <article
    class:list={[
      'mx-auto px-5 py-6 [overflow-wrap:anywhere] lg:px-8',
      cmsData ? 'max-w-[52rem]' : 'max-w-4xl',
    ]}
  >
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: withBase('/') },
        { label: 'ニュース・航空知識', href: withBase('/insights/') },
        { label: data.title },
      ]}
    />
    {isPublished || isDraftPreview ? (
      <>
        {manualTarget && (
          <p class="my-6 rounded-lg border border-teal-200 bg-teal-50 p-4">
            <a href={withBase(manualTarget)}>RC4GS V2 日本語マニュアルを読む</a>{' '}
            — このページの内容は新しいマニュアルへ移しました。
          </p>
        )}
        <ArticleHero
          article={data}
          cms={!!cmsData}
          lead={cmsPresentation?.lead}
        />
        {!cmsData && <ArticleShare title={data.title} url={routeUrl} />}
        {cmsData && cmsData.tags.length > 0 && (
          <ul class="flex list-none flex-wrap gap-2 p-0 my-2" aria-label="タグ">
            {cmsData.tags.map((tag) => (
              <li class="rounded-full bg-teal-50 px-3 py-1 text-sm text-teal-800">
                {tag}
              </li>
            ))}
          </ul>
        )}

        {!cmsData && (
          <section
            class="border-y border-slate-200 py-7 text-xl leading-9 text-slate-700"
            data-article-section="introduction"
          >
            <p>{description}</p>
          </section>
        )}

        <div
          class={
            cmsData
              ? 'mt-5'
              : 'prose prose-slate mt-10 max-w-none overflow-x-auto [&_iframe]:aspect-video [&_iframe]:h-auto [&_iframe]:max-w-full [&_iframe]:w-full [&_img]:h-auto [&_img]:max-w-full'
          }
          data-article-section="body"
        >
          {isWordpress ? (
            <Fragment
              set:html={wordpressBody!.replaceAll(
                /\b(href|src)="(\/(?:assets\/insights\/wordpress|downloads|wp-content)\/[^"]+)"/g,
                (_, attr: string, src: string) => `${attr}="${withBase(src)}"`,
              )}
            />
          ) : cmsPresentation ? (
            <CmsArticleBody pages={cmsPresentation.pages} />
          ) : (
            Content && <Content />
          )}
        </div>

        {cmsData && cmsData.gallery.length > 0 && (
          <section
            class="mt-10 grid gap-6 sm:grid-cols-2"
            aria-label="追加画像"
          >
            {cmsData.gallery.map((image) => (
              <figure class="m-0">
                <ResponsiveMedia
                  media={{ ...image, image_status: 'verified' }}
                />
                <figcaption class="mt-2 text-sm text-slate-600">
                  {image.alt}
                </figcaption>
              </figure>
            ))}
          </section>
        )}

        {relatedProducts.length > 0 && (
          <section class="mt-12" aria-label="関連商品">
            <h2 class="text-2xl font-bold text-slate-950">関連商品</h2>
            <ul class="mt-4 flex list-none flex-wrap gap-3 p-0">
              {relatedProducts.map((product) => (
                <li>
                  <a
                    class="underline"
                    href={withBase(
                      product.detailPath ?? '/radiolink/#products',
                    )}
                  >
                    {product.name}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}

        {!cmsData && (
          <section class="mt-12" data-article-section="related">
            <h2 class="text-2xl font-bold text-slate-950">関連情報</h2>
            <UnverifiedNotice text="関連する記事はありません。" />
          </section>
        )}

        <footer
          class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-600"
          data-article-section="attribution"
        >
          {cmsData && <ArticleShare title={data.title} url={routeUrl} />}
          <p>編集: {SITE_NAME}</p>
          {isWordpress && (
            <p>
              <a
                href={
                  manualTarget
                    ? withBase(manualTarget)
                    : wordpressData!.canonical
                }
              >
                {manualTarget
                  ? 'RC4GS V2 日本語マニュアルを見る'
                  : '元の記事を見る'}
              </a>
            </p>
          )}
        </footer>
      </>
    ) : (
      <section class="py-10 lg:py-16" data-article-availability>
        <p class="mb-3 text-sm font-bold tracking-[0.14em] text-teal-700 uppercase">
          {data.topic}
        </p>
        <h1 class="m-0 max-w-4xl text-4xl leading-tight font-bold tracking-tight text-slate-950 sm:text-6xl">
          {data.title}
        </h1>
        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <h2 class="m-0 text-2xl font-bold text-slate-950">
            この記事は現在お読みいただけません。
          </h2>
          <p class="mt-3 text-slate-600">
            ニュース・航空知識の一覧から、ほかの記事をご覧ください。
          </p>
          <a
            class="mt-2 inline-block font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
            href={withBase('/insights/')}
          >
            ニュース・航空知識へ戻る
          </a>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
