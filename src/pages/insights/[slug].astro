---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import AdSlot from '../../components/AdSlot.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import UnverifiedNotice from '../../components/UnverifiedNotice.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  buildArticleJsonLd,
  buildBreadcrumbJsonLd,
} from '../../lib/structured-data';
import { canonicalUrl, withBase } from '../../lib/urls';

interface Props {
  article: CollectionEntry<'insights'>;
}

export async function getStaticPaths() {
  const insights = await getCollection('insights');
  return insights.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const { data } = article;
const { Content } = await render(article);
const isPublished = data.content_status === 'published';
const articleUrl = canonicalUrl(`/insights/${data.slug}/`);
const kind =
  data.article_kind === 'technical_explainer' ? 'TechArticle' : 'Article';
const breadcrumbJsonLd = buildBreadcrumbJsonLd([
  { name: 'ホーム', url: canonicalUrl('/') },
  { name: '業界・技術', url: canonicalUrl('/insights/') },
  { name: data.title, url: articleUrl },
]);
const jsonLd = isPublished
  ? [
      breadcrumbJsonLd,
      buildArticleJsonLd({
        kind,
        headline: data.title,
        description: data.description,
        url: articleUrl,
        datePublished: data.published_at.toISOString(),
        dateModified: data.updated_at.toISOString(),
        author: 'happinesea',
      }),
    ]
  : breadcrumbJsonLd;
const description = isPublished
  ? data.description
  : '業界・技術の記事は、内容を確認したうえで順次掲載します。';
---

<BaseLayout
  title={data.title}
  description={description}
  canonicalPath={`/insights/${data.slug}/`}
  type={isPublished ? 'article' : 'website'}
  jsonLd={jsonLd}
>
  <article class="mx-auto max-w-4xl px-5 py-6 lg:px-8">
    <Breadcrumbs
      items={[
        { label: 'ホーム', href: withBase('/') },
        { label: '業界・技術', href: withBase('/insights/') },
        { label: data.title },
      ]}
    />
    {isPublished ? (
      <>
        <ArticleHero article={data} />

        <section
          class="border-y border-slate-200 py-7 text-xl leading-9 text-slate-700"
          data-article-section="introduction"
        >
          <p>{data.description}</p>
        </section>

        <div
          class="prose prose-slate mt-10 max-w-none"
          data-article-section="body"
        >
          <Content />
        </div>

        <AdSlot label="記事内広告掲載候補" />

        <section class="mt-12" data-article-section="related">
          <h2 class="text-2xl font-bold text-slate-950">関連情報</h2>
          <UnverifiedNotice text="関連する公開情報はありません。" />
        </section>

        <footer
          class="mt-12 border-t border-slate-200 pt-6 text-sm text-slate-600"
          data-article-section="attribution"
        >
          <p>編集・公開: happinesea</p>
        </footer>
      </>
    ) : (
      <section class="py-10 lg:py-16" data-article-availability>
        <p class="mb-3 text-sm font-bold tracking-[0.14em] text-teal-700 uppercase">
          {data.topic}
        </p>
        <h1 class="m-0 max-w-4xl text-4xl leading-tight font-bold tracking-tight text-slate-950 sm:text-6xl">
          {data.title}
        </h1>
        <div class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
          <h2 class="m-0 text-2xl font-bold text-slate-950">
            この記事の本文は現在掲載していません。
          </h2>
          <p class="mt-3 text-slate-600">
            業界・技術の記事は、内容を確認したうえで順次掲載します。
          </p>
          <a
            class="mt-2 inline-block font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
            href={withBase('/insights/')}
          >
            業界・技術へ戻る
          </a>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
