---
import { getCollection } from 'astro:content';
import InsightCard from '../../components/InsightCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const insights = [
  ...(await getCollection('insights')).filter(
    ({ data }) => data.content_status === 'published',
  ),
  ...(await getCollection('wordpressInsights')),
].sort((a, b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());
const topics = [
  '航空・ドローン',
  'RC技術',
  '法規・制度',
  '業界動向',
  '技術解説',
  '導入事例',
] as const;
---

<BaseLayout
  title="ニュース・航空知識"
  description="航空のニュース、ラジコン・ドローンの技術や使い方を記事・動画で紹介しています。"
>
  <section
    class="border-b border-slate-300 bg-slate-950 text-white"
    data-editorial-index
  >
    <div class="mx-auto max-w-[var(--site-max-width)] px-5 py-16 lg:px-8 lg:py-24">
      <p class="mb-3 text-sm font-bold tracking-[0.18em] text-teal-300 uppercase">
        読み物・動画
      </p>
      <h1 class="m-0 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl">
        ニュース・航空知識
      </h1>
      <p class="mt-6 max-w-2xl text-lg text-slate-300">
        航空の話題や、ラジコン・ドローンの仕組みと使い方。気になる記事や動画を探してみてください。
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-[var(--site-max-width)] px-5 py-14 lg:px-8 lg:py-20">
    <SectionHeading title="テーマから楽しむ" />
    <ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
      {topics.map((topic) => (
        <li
          class="rounded-full border border-slate-300 px-4 py-2 text-sm font-bold text-slate-700"
          data-topic-label={topic}
        >
          {topic}
        </li>
      ))}
    </ul>

    {insights.length ? (
      <div class="mt-14">
        {insights.map((insight) => (
          <InsightCard insight={insight} />
        ))}
      </div>
    ) : (
      <div
        class="mt-14 rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8"
        data-insights-empty
      >
        <h2 class="m-0 text-2xl font-bold text-slate-950">
          現在、この一覧で読める記事はありません。
        </h2>
        <p class="mt-3 text-slate-600">
          これまでの記事は、happinesea
          hobbyのニュース・航空知識からご覧いただけます。
        </p>
        <a
          class="mt-2 inline-block font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
          href="https://happinesea.com/category/news"
        >
          これまでの記事を読む
        </a>
      </div>
    )}
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      <a
        class="rounded-2xl border border-slate-200 p-6 no-underline hover:border-teal-600"
        href="https://happinesea.com/drawinglibrary"
      >
        <h2 class="m-0 text-xl font-bold text-slate-950">設計図ライブラリ</h2>
        <p class="mb-0 text-slate-600">
          飛行機などの設計図をお探しの方はこちら。
        </p>
      </a>
      <a
        class="rounded-2xl border border-slate-200 p-6 no-underline hover:border-teal-600"
        href="https://happinesea.com/drone-rc-glossary"
      >
        <h2 class="m-0 text-xl font-bold text-slate-950">基本用語集</h2>
        <p class="mb-0 text-slate-600">
          ラジコン・ドローンの用語を調べられます。
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
