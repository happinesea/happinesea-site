---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import manuals from '../../lib/receiver-manuals.mjs';
import { isInitialManualRelease } from '../../lib/manual-release.mjs';

const { entry } = Astro.locals.starlightRoute;
const manual = manuals.manuals.find(
  (item) => item.route === `/${entry.data.slug}/`,
);
const showEdition = manual && isInitialManualRelease(manual);
---

<DefaultPageTitle />
{showEdition && (
  <aside aria-label="日本語版と原典" class="mt-3 text-sm">
    <p>
      {manual.model} 日本語Web版 初版（v1.0）。happinesea.comによる翻訳です。
    </p>
    {manual.withheld_unit_ids.length > 0 && (
      <p>
        操作・接続の手順を掲載していない箇所は、お使いの機器に対応するメーカーの説明書をご参照ください。
      </p>
    )}
    {manual.source.source_url && (
      <a href={manual.source.source_url} rel="noopener noreferrer">
        Radiolink公式原典（{manual.source.version || '版の記載なし'}）
      </a>
    )}
  </aside>
)}
