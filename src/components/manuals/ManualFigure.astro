---
import { withBase } from '../../lib/urls';

interface Props {
  src: string;
  alt: string;
  caption: string;
  width?: number;
  height?: number;
  figureId?: string;
}

const { src, alt, caption, width, height, figureId } = Astro.props;
---

<figure data-manual-figure data-source-figure={figureId} class="manual-figure">
  <img
    src={withBase(src)}
    alt={alt}
    width={width}
    height={height}
    loading="lazy"
    decoding="async"
  />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .manual-figure {
    margin-block: 1.5rem;
  }

  img {
    max-height: 44rem;
    margin-inline: auto;
    object-fit: contain;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
    text-align: center;
  }
</style>
