---
interface Props {
  youtubeId: string;
  title: string;
  description?: string;
}

const { youtubeId, title, description } = Astro.props;
---

<figure data-manual-video class="manual-video">
  <div>
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title={title}
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  </div>
  <figcaption>
    <strong>{title}</strong>
    {description && <span>{description}</span>}
  </figcaption>
</figure>

<style>
  .manual-video {
    margin-block: 1.5rem;
  }

  .manual-video > div {
    aspect-ratio: 16 / 9;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: 0.75rem;
  }

  figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: 0.875rem;
  }
</style>
