---
import { withBase } from '../lib/urls';

interface Source {
  src: string;
  type: 'image/avif' | 'image/webp';
}

interface Media {
  src?: string;
  alt?: string;
  width?: number;
  height?: number;
  image_status: 'verified' | 'unverified' | 'unavailable';
  sources?: Source[];
}

interface Props {
  media?: Media;
  eager?: boolean;
  class?: string;
  placeholderLabel?: string;
}

const {
  media,
  eager = false,
  class: className,
  placeholderLabel = '画像準備中',
} = Astro.props;

const isExternal = (value: string) =>
  /^[a-z][a-z\d+.-]*:/i.test(value) || value.startsWith('//');
const resolveSrc = (value: string) => (isExternal(value) ? value : withBase(value));

const isVerified = media?.image_status === 'verified' && media.src;

if (isVerified && media.alt === undefined) {
  throw new TypeError('Verified media requires alt text');
}
---

{isVerified ? (
  <picture class={className}>
    {media.sources?.map((source) => (
      <source srcset={resolveSrc(source.src)} type={source.type} />
    ))}
    <img
      src={resolveSrc(media.src!)}
      alt={media.alt!}
      width={media.width}
      height={media.height}
      loading={eager ? 'eager' : 'lazy'}
      decoding={eager ? 'sync' : 'async'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="h-auto w-full rounded-3xl object-contain"
      referrerpolicy="no-referrer"
    />
  </picture>
) : (
  <div
    class:list={[
      'grid min-h-56 place-items-center rounded-3xl border border-dashed border-slate-300 bg-slate-100 text-sm font-semibold text-slate-600',
      className,
    ]}
    role="img"
    aria-label={placeholderLabel}
  >
    {placeholderLabel}
  </div>
)}
