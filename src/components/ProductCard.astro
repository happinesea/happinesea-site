---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';

interface Props {
  product: CollectionEntry<'products'>;
}

const { product } = Astro.props;
const { data } = product;
const catalogueImages: Record<string, string> = {
  rc8x: '/assets/radiolink/catalogue/rc8x.webp',
  rc8p: '/assets/radiolink/catalogue/rc8p.webp',
  t12d: '/assets/radiolink/catalogue/t12d.webp',
  r16f: '/assets/radiolink/catalogue/r16f.webp',
  r12f: '/assets/radiolink/catalogue/r12f.webp',
  r8fg: '/assets/radiolink/catalogue/r8fg.webp',
  r7fg: '/assets/radiolink/catalogue/r7fg.webp',
  r6fg: '/assets/radiolink/catalogue/r6fg.webp',
};
const cardImage = catalogueImages[data.slug] ?? data.media.hero.src;
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  data-product-category={data.category}
>
  <div class="grid aspect-[16/9] place-items-center bg-white p-6 text-sm font-semibold text-slate-600">
    {cardImage ? (
      <img
        class="h-full w-full object-contain"
        src={withBase(cardImage)}
        alt={data.media.hero.alt}
        loading="lazy"
        data-product-card-image
      />
    ) : (
      <span>画像準備中</span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="m-0 text-sm font-bold text-teal-700">{data.category}</p>
    <h3 class="mt-2 mb-0 text-2xl font-bold text-slate-950">{data.title}</h3>
    <p class="mt-3 flex-1 text-slate-600">{data.description}</p>
    <a
      class="mt-5 font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
      href={withBase(`/radiolink/${data.slug}/`)}
    >
      製品情報を見る
    </a>
  </div>
</article>
