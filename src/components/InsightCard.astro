---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/urls';

interface Props {
  insight: CollectionEntry<'insights'>;
}

const { insight } = Astro.props;
const { data } = insight;
---

<article class="border-t border-slate-300 py-7 sm:grid sm:grid-cols-[11rem_1fr] sm:gap-8">
  <div>
    <p class="m-0 text-sm font-bold text-teal-700">{data.topic}</p>
    <time
      class="mt-2 block text-sm text-slate-500"
      datetime={data.published_at.toISOString()}
    >
      {data.published_at.toLocaleDateString('ja-JP')}
    </time>
  </div>
  <div>
    <h2 class="mt-3 mb-0 text-2xl font-bold leading-snug text-slate-950 sm:mt-0 sm:text-3xl">
      <a
        class="no-underline hover:text-teal-800"
        href={withBase(`/insights/${data.slug}/`)}
      >
        {data.title}
      </a>
    </h2>
    <p class="mb-0 text-slate-600">{data.description}</p>
  </div>
</article>
