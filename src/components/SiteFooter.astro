---
import { getNavigation, SITE_NAME } from '../lib/site';
import { withBase } from '../lib/urls';

const navigation = getNavigation();
const home = withBase('/');
---

<footer class="mt-24 border-t border-slate-200 bg-slate-50">
  <div class="mx-auto grid max-w-[var(--site-max-width)] gap-10 px-5 py-12 md:grid-cols-[1fr_auto] lg:px-8">
    <div>
      <a class="font-bold text-slate-950 no-underline" href={home}>
        {SITE_NAME}
      </a>
      <p class="mt-3 max-w-xl text-sm text-slate-600">
        航空・RC・ドローン分野の製品理解からマニュアル、サポート、業界・技術情報までを整理する日本語情報サイトです。
      </p>
    </div>
    <nav aria-label="フッターナビゲーション">
      <ul class="m-0 grid list-none grid-cols-2 gap-x-8 gap-y-3 p-0 text-sm">
        {navigation.map((item) => (
          <li>
            <a class="text-slate-600 hover:text-teal-800" href={item.href}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-slate-200 px-5 py-5 text-center text-xs text-slate-500">
    © {new Date().getFullYear()} happinesea
  </div>
</footer>
