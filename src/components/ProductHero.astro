---
import type { CollectionEntry } from 'astro:content';
import { LINE_URL } from '../lib/site';
import { withBase } from '../lib/urls';
import ResponsiveMedia from './ResponsiveMedia.astro';

interface Props {
  product: CollectionEntry<'products'>['data'];
  copy?: {
    tagline: string;
    subline: string;
    note: string;
  };
}

const { product, copy } = Astro.props;
const media = {
  src: product.media.hero.src ?? undefined,
  alt: product.media.hero.alt,
  width: product.media.hero.width ?? undefined,
  height: product.media.hero.height ?? undefined,
  image_status: product.media.hero.image_status,
};
---

<section
  class="grid gap-10 py-10 lg:grid-cols-2 lg:items-center lg:py-16"
  data-product-section="overview"
>
  <div>
    <div class="mb-3 flex flex-wrap items-center gap-3">
      <p class="m-0 text-sm font-bold tracking-[0.16em] text-teal-700 uppercase">
        {product.manufacturer}
      </p>
      {product.content_status === 'manufacturer_review' && (
        <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-bold text-amber-900">
          メーカー確認中
        </span>
      )}
    </div>
    <h1 class="m-0 text-4xl font-bold tracking-tight text-slate-950 sm:text-6xl">
      {product.model}
    </h1>
    <p class="mt-5 text-2xl font-bold text-slate-900">
      {copy?.tagline ?? product.description}
    </p>
    {copy?.subline && <p class="mt-2 text-lg text-slate-600">{copy.subline}</p>}
    {copy?.note && <p class="mt-4 text-sm text-slate-500">{copy.note}</p>}
    <div class="mt-7 flex flex-wrap gap-3">
      <a
        class="inline-flex items-center rounded-full bg-slate-950 px-5 py-3 font-bold text-white no-underline"
        href={withBase(`/manuals/${product.slug}/`)}
      >
        日本語マニュアル
      </a>
      <a
        class="inline-flex items-center gap-2 rounded-full border border-slate-300 px-5 py-3 font-bold text-slate-900 no-underline"
        href={product.manual_url}
        target="_blank"
        rel="noopener noreferrer"
      >
        英語マニュアル
        <span class="text-xs font-medium text-slate-500">Radiolink公式・外部サイト</span>
      </a>
      <a
        class="inline-flex items-center rounded-full bg-[#06c755] px-5 py-3 font-bold text-white no-underline"
        href={LINE_URL}
        rel="noreferrer"
      >
        LINEで相談
      </a>
    </div>
  </div>
  <ResponsiveMedia
    media={media}
    eager
    placeholderLabel={`${product.model} 製品画像準備中`}
  />
</section>
