---
import { withBase } from '../lib/urls';
interface Props {
  drawing: {
    title: string;
    category: string;
    description: string;
    href: string;
    downloadHref: string;
    hero: { src: string; alt: string; width: number; height: number } | null;
  };
}
const { drawing } = Astro.props;
const detailHref = withBase(`${drawing.href.replace(/\/$/, '')}/`);
---

<article
  class="flex h-full flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
  data-drawing-card
  data-product-category={drawing.category}
>
  <a
    href={detailHref}
    class="grid aspect-[4/3] place-items-center bg-slate-50 p-5"
    tabindex="-1"
    aria-hidden="true"
  >
    {drawing.hero && (
      <img
        src={withBase(drawing.hero.src)}
        alt={drawing.hero.alt}
        width={drawing.hero.width}
        height={drawing.hero.height}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-contain"
      />
    )}
  </a>
  <div class="flex flex-1 flex-col border-t border-slate-100 p-5">
    <p class="text-xs font-bold text-teal-700">{drawing.category}</p>
    <h2 class="mt-2 text-xl leading-8 font-bold text-slate-950">
      <a href={detailHref} class="hover:text-teal-800">
        {drawing.title}
      </a>
    </h2>
    <p class="mt-3 text-sm leading-7 text-slate-600">{drawing.description}</p>
    <div class="mt-auto flex flex-wrap gap-x-5 gap-y-3 pt-6">
      <a
        href={detailHref}
        class="font-bold text-teal-800 underline decoration-teal-300 underline-offset-4"
      >
        設計図・資料を見る
      </a>
      <a
        href={withBase(drawing.downloadHref)}
        download
        class="text-sm text-slate-600 underline underline-offset-4"
      >
        ファイルをダウンロード
      </a>
    </div>
  </div>
</article>
