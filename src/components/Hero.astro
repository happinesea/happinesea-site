---
interface Action {
  label: string;
  href: string;
  secondary?: boolean;
}

interface Visual {
  src: string;
  alt: string;
  label: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  actions: Action[];
  visuals: Visual[];
}

import { withBase } from '../lib/urls';

const { eyebrow, title, description, actions, visuals } = Astro.props;
---

<section class="overflow-hidden border-b border-slate-200 bg-slate-950 text-white">
  <div class="mx-auto grid max-w-[var(--site-max-width)] gap-10 px-5 py-20 lg:grid-cols-[1.2fr_0.8fr] lg:px-8 lg:py-28">
    <div>
      <p class="mb-5 text-sm font-bold tracking-[0.22em] text-teal-300 uppercase">
        {eyebrow}
      </p>
      <h1 class="m-0 max-w-4xl text-4xl leading-tight font-bold tracking-tight sm:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
        {description}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        {actions.map((action) => (
          <a
            class:list={[
              'rounded-full px-5 py-3 text-sm font-bold no-underline transition',
              action.secondary
                ? 'border border-slate-500 text-white hover:border-teal-300 hover:text-teal-200'
                : 'bg-teal-400 text-slate-950 hover:bg-teal-300',
            ]}
            href={action.href}
          >
            {action.label}
          </a>
        ))}
      </div>
    </div>
    <div class="grid grid-cols-2 gap-3 rounded-3xl border border-slate-700 bg-slate-900 p-3 sm:p-5">
      {visuals.map((visual, index) => (
        <figure
          class:list={[
            'm-0 overflow-hidden rounded-2xl bg-white p-3 text-slate-950',
            index === 0 && 'col-span-2',
          ]}
        >
          <img
            class:list={[
              'w-full object-contain',
              index === 0 ? 'h-40 sm:h-48' : 'h-24 sm:h-28',
            ]}
            src={withBase(visual.src)}
            alt={visual.alt}
          />
          <figcaption class="mt-2 text-center text-xs font-bold text-slate-600">
            {visual.label}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
