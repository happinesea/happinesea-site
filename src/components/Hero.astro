---
interface Action {
  label: string;
  href: string;
  secondary?: boolean;
}

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  actions: Action[];
}

const { eyebrow, title, description, actions } = Astro.props;
---

<section class="overflow-hidden border-b border-slate-200 bg-slate-950 text-white">
  <div class="mx-auto grid max-w-[var(--site-max-width)] gap-10 px-5 py-20 lg:grid-cols-[1.2fr_0.8fr] lg:px-8 lg:py-28">
    <div>
      <p class="mb-5 text-sm font-bold tracking-[0.22em] text-teal-300 uppercase">
        {eyebrow}
      </p>
      <h1 class="m-0 max-w-4xl text-4xl leading-tight font-bold tracking-tight sm:text-6xl">
        {title}
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-300">
        {description}
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        {actions.map((action) => (
          <a
            class:list={[
              'rounded-full px-5 py-3 text-sm font-bold no-underline transition',
              action.secondary
                ? 'border border-slate-500 text-white hover:border-teal-300 hover:text-teal-200'
                : 'bg-teal-400 text-slate-950 hover:bg-teal-300',
            ]}
            href={action.href}
          >
            {action.label}
          </a>
        ))}
      </div>
    </div>
    <div
      aria-hidden="true"
      class="relative min-h-64 rounded-3xl border border-slate-700 bg-slate-900 p-6"
    >
      <div class="absolute inset-6 rounded-2xl border border-teal-400/30"></div>
      <div class="absolute top-1/2 right-12 left-12 h-px bg-teal-400/40"></div>
      <div class="absolute top-12 bottom-12 left-1/2 w-px bg-teal-400/40"></div>
      <div class="absolute top-1/2 left-1/2 size-24 -translate-x-1/2 -translate-y-1/2 rounded-full border border-teal-300/70 bg-teal-400/10"></div>
    </div>
  </div>
</section>
