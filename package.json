{
  "name": "happinesea-site",
  "version": "0.1.0",
  "private": true,
  "description": "happinesea public static site",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run assets:verify -- src/data/publication-assets/rc8x.json && npm run wordpress:sync && astro build && node scripts/copy-wordpress-aliases.mjs && node scripts/finalize-legacy-compatibility.mjs && node scripts/verify-sitemap.mjs",
    "preview": "astro preview",
    "test": "node --test tests/unit/*.test.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:dist": "node --test tests/build-output.test.mjs",
    "test:e2e": "playwright test",
    "validate": "npm run test && npm run check && npm run lint && npm run format:check && npm run build && npm run test:dist",
    "import:publication": "node scripts/import-publication.mjs",
    "assets:sync": "node scripts/process-assets.mjs",
    "assets:verify": "node scripts/verify-assets.mjs",
    "wordpress:sync": "npm run wordpress:inventory && node scripts/sync-wordpress-insights.mjs",
    "wordpress:inventory": "node scripts/inventory-wordpress-insights.mjs",
    "legacy:sync": "node scripts/sync-legacy-compatibility.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.4",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@typescript-eslint/parser": "8.70.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-astro": "1.7.0",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "sanitize-html": "^2.18.0",
    "sharp": "0.35.5",
    "sitemap": "9.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
